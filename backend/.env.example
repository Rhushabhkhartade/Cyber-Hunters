# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file.

APP_NAME=SentinelAI API
APP_ENV=development
APP_DEBUG=true

# Generate a strong random secret (e.g. openssl rand -hex 32)
SECRET_KEY=replace-this-with-a-strong-secret-key

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=SentinelAI
MONGO_DB_NAME=sentinelai

UPLOAD_DIR=uploads

# Optional: enable a demo login user for development
DEV_AUTH_ENABLED=false
DEV_AUTH_USERNAME=demo
DEV_AUTH_PASSWORD=replace-with-strong-password

# Optional: Supabase storage integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
